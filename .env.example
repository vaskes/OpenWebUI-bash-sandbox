# OpenWebUI-bash-sandbox — operator env template.
#
# Copy to .env and edit the CHANGE_ME values.
#
# `make up` / `make build` / `make restart` invoke the `check-env` target
# first, and it fails with exit 2 and lists the offending keys while a
# CHANGE_ME placeholder is still here. The services refuse the same
# placeholder on their own — a placeholder is a published string, not a
# secret — so a stack started another way comes up and answers
# "503 proxy not configured" instead of serving a shell.
#
# Generate the secrets with:
#   openssl rand -hex 32   # → OPENAPI_PROXY_TOKEN (32-byte hex)
#   openssl rand -base64 48 # → WEBUI_SECRET_KEY (48-byte base64)
#
# The proxy token is interpolated into the Open WebUI tool connection as
# JSON and travels in an HTTP header, so it must not contain a quote, a
# backslash, whitespace or non-ASCII characters. `openssl rand -hex 32`
# gives exactly that; `make check-env` refuses anything else and tells
# you to regenerate it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bearer token shared between openapi-proxy and sandbox-agent.
# `openssl rand -hex 32` gives 64 hex characters — the length is a
# recommendation, not a rule: the character set is what breaks the token
# (a quote, a backslash, whitespace or a non-ASCII character breaks the
# JSON interpolation or the HTTP header), and `make check-env` refuses it.
# The agent refuses to *serve* if its token is empty; the CHANGE_ME
# placeholder is caught by `make check-env`, which `make up` / `build` /
# `restart` run — `make logs` and `make down` do not need the env.
OPENAPI_PROXY_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Open WebUI session secret. 64+ chars.
# Used to sign cookies; rotating it logs everyone out.
WEBUI_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48

# ---------------------------------------------------------------------------
# Open WebUI behaviour
# ---------------------------------------------------------------------------

WEBUI_AUTH=true
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user

# The address the published ports bind to. Default: 127.0.0.1 (the
# loopback — the stack is reachable only from this machine).
# 0.0.0.0 publishes on every interface; that is a deployment that wants
# the port reachable from the network, and it leaves the bearer token as
# the only thing between that network and a shell.
# SANDBOX_BIND_HOST=127.0.0.1

# The whisper-api URL, as the container sees the Docker host. Default:
# http://host.docker.internal:8000/v1 — the local whisper-api service.
# AUDIO_STT_OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1

# ---------------------------------------------------------------------------
# openapi-proxy
# ---------------------------------------------------------------------------

# CORS allowlist. Comma-separated origins. Empty = no browser access
# (server-to-server clients still work, only browser preflight is blocked).
# Example: https://app.example.com
OPENAPI_PROXY_CORS_ORIGINS=

# SSH host allowlist for the `ssh` shortcut. Comma-separated hostnames
# or CIDRs. Empty = ssh shortcut disabled entirely.
# Example: lab.local,10.0.0.0/8
OPENAPI_PROXY_SSH_ALLOWLIST=

# Per-token rate limit (requests / minute). 0 = disabled.
OPENAPI_PROXY_RATE_LIMIT_RPM=120

# How large an upload (POST /files) may be before the proxy refuses it.
# A plain byte count, like the proxy's other numbers. Default: 67108864
# (64 MiB).
#
# This is the proxy's *transport* ceiling: the file policy belongs to the
# agent (AGENT_BINARY_LIMIT), and the proxy only has to be able to carry
# a body the agent will accept. It has to be at least the agent's file
# policy - otherwise the proxy refuses an upload the agent would have
# taken.
# OPENAPI_PROXY_UPLOAD_MAX_BYTES=67108864

# LRU cap for the rate limiter. Past this we evict the least-recently-used
# key — prevents unbounded memory growth under token-spraying attacks.
OPENAPI_PROXY_RATE_LIMIT_MAX_KEYS=10000

# WebSocket /ws idle timeout (seconds). Forgotten browser tabs are
# closed by the server after this long. 0 = disabled.
# NEW in v2.4.0 (sandbox-recommendations #M3).
OPENAPI_PROXY_WEBSOCKET_IDLE_TIMEOUT=300

# If the upstream sandbox-agent uses a different bearer token than
# OPENAPI_PROXY_TOKEN (unusual), set this. Defaults to OPENAPI_PROXY_TOKEN.
# Leave it empty — do not set it to an empty string: an empty value is a
# value, and the proxy would forward no Authorization header at all.
# OPENAPI_PROXY_UPSTREAM_TOKEN=

# The bearer token the sandbox-agent accepts on its own doors. Empty =
# the same token as OPENAPI_PROXY_TOKEN, which is the usual
# single-trust-boundary case.
#
# Set it to a DIFFERENT value when the agent's token must not be the
# operator's: the model's shell inherits the agent's environment, so
# with one token for the whole stack the model can read the operator's
# own credential — and the sandbox has unrestricted outbound network
# access. With a separate value, the model can only ever see the
# internal one. See docs/SECURITY.md, "The sandbox is not a boundary".
# AGENT_INBOUND_TOKEN=

# ---------------------------------------------------------------------------
# sandbox-agent
# ---------------------------------------------------------------------------

# The uvicorn log level of the agent: debug, info, warning, error.
# Default: INFO. Raising it to debug is how you watch a command that
# refuses to start.
# AGENT_LOG_LEVEL=INFO

# The agent's writable surface and its session registry are set by the
# compose file and are not knobs: the bind-mount and the two paths have
# to agree with each other, so they are changed in docker-compose.yml,
# not here.

# How much text one command may return in one exec. Accepts a plain byte
# count or a k/m/g suffix. Allowed range: 32k .. 1024k. Default: 512k.
# The value is a startup failure, not a clamp — a typo must be loud.
# The tmux scrollback is sized from it, so an output that fits the budget
# comes back whole on every run instead of sometimes losing its head.
# AGENT_STDOUT_LIMIT=512k

# How large a file the binary endpoint (/files) will serve. 0 = unlimited.
# Accepts the same size syntax. Default: 2048k. Binary never travels
# through stdout, so this is a policy cap and not a transport limit.
# AGENT_BINARY_LIMIT=2048k

# How large an upload (POST /files) may be before the request is refused.
# Accepts the same size syntax. Default: 64m.
#
# This is the *transport* ceiling of the upload door, not the file policy:
# the file that lands is still measured against AGENT_BINARY_LIMIT, and
# this number only decides how many bytes are read before the request is
# refused. It therefore has to be at least AGENT_BINARY_LIMIT - a
# transport ceiling below the file policy refuses an upload the door
# itself would have accepted, and refuses it with the vaguer of the two
# answers. Every other door keeps the 2 MB body guard.
# AGENT_UPLOAD_MAX_BYTES=64m

# How many bytes one MCP read_file call may put into a model's context.
# Accepts the same size syntax. Allowed range: 0 .. 64m. Default: 1m.
# 0 = no budget of its own (the binary limit and the 64 MiB ceiling
# decide then).
#
# This is a different axis from AGENT_BINARY_LIMIT: there the bytes land
# in a file on the caller's disk, here they land in a prompt — and a
# text model asked to reason about a megabyte of text has lost the
# thread. A file over the budget is refused, and the refusal names the
# file's size and the limit. The HTTP /files door is not affected: it
# keeps its own limit.
# AGENT_MCP_MAX_READ_BYTES=1m

# How many processes the agent's shell may spawn. 256 is the safe
# default: a fork-bomb dies in the container instead of on the host.
# Raise it when a legitimate build fans out (make -j, npm, pip workers)
# and the commands start failing with "Resource temporarily unavailable".
# AGENT_PIDS_LIMIT=256

# The Host header values the MCP endpoint (/mcp) answers for.
# Comma-separated. EMPTY = the check is off — the default, and the SDK's
# own default for a service that is not bound to the loopback: a
# containerised service is reached by its service name, and a list that
# does not contain that name refuses every legitimate caller.
#
# Set it to turn the protection against DNS rebinding on: a request
# whose Host is not on the list is then refused with a 421. The bearer
# token is the guard either way — this is one more layer.
# AGENT_MCP_ALLOWED_HOSTS=example.com

# ---------------------------------------------------------------------------
# openapi-proxy
# ---------------------------------------------------------------------------

# The longest a single command may run, in seconds. Allowed range: 5 .. 3600.
# Default: 60. A value outside the range is a startup failure, not a clamp.
#
# The proxy asks the agent for exactly this limit and then waits longer
# than it (limit + 15s), because the agent answers *after* the limit
# expires: "this command timed out", with the output it managed to
# produce. With the same number on both sides, that answer arrives at the
# very moment the proxy stops listening, and the caller gets a transport
# error instead of the timeout it asked for.
# AGENT_EXEC_TIMEOUT=60

# ---------------------------------------------------------------------------
# The privilege mode — for private deployments in secured environments only
# ---------------------------------------------------------------------------
#
# Off by default, and it must stay off in a deployment where the model's
# input can be hostile. With it on, a command in the sandbox can run
# `sudo su` and become ROOT inside the container — a prompt injection
# that reaches the shell gets root.
#
# Only for private deployments in secured environments: the container is
# the boundary, but inside it the model is root.
#
# All three of the escalation settings are needed; the first one alone
# is a broken half. The fourth one is described further down.
# See docs/SECURITY.md, "The privilege mode".
#
# AGENT_ALLOW_SUDO=1
# AGENT_NO_NEW_PRIVILEGES=false
# AGENT_CAP_DROP=SYS_ADMIN
#
# The fourth setting decides whether that root is USEFUL. The default
# is a read-only root filesystem, and a root shell in a read-only
# container cannot change a byte of it: apt-get needs /var/lib/apt/lists,
# /var/lib/dpkg and /usr to be writable and gets "Read-only file
# system" for all three. Set it to false if the privileged root has to
# install packages. The writable layer is the container's own — it dies
# with the container, and the container stays the boundary.
#
# AGENT_READ_ONLY=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Whisper (STT) uses a local server. No key needed if the local server
# accepts unauthenticated requests; otherwise set the bearer it expects.
WHISPER_API_KEY=sk-not-needed
