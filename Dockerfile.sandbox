# Sandbox agent — persistent tmux sessions per chat, exposed via HTTP API
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash tmux \
    openssh-client sshpass \
    git curl wget \
    jq ripgrep fd-find \
    python3 python3-pip python3-venv \
    ca-certificates gnupg \
    htop tree \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Python packages
RUN pip3 install --no-cache-dir --break-system-packages \
    fastapi 'uvicorn[standard]' pydantic httpx

# Workspace layout
RUN mkdir -p /workspace && chmod 755 /workspace
WORKDIR /workspace

# Agent HTTP API
COPY agent_api.py /opt/agent_api.py
EXPOSE 8082

# Healthcheck
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8082/healthz || exit 1

CMD ["python3", "/opt/agent_api.py"]
