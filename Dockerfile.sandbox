# syntax=docker/dockerfile:1.6
# Multi-stage build: builder stage installs pip deps, runtime stage
# copies only the wheel cache and runs as a non-root user.
#
# Sandbox agent — persistent tmux sessions per chat, exposed via HTTP API.
#
# IMPORTANT: WORKDIR is /home/agent so the python import path resolves
# ``agent_api`` and ``agent_core`` from the same directory the source files
# are copied into. WORKDIR=/workspace caused a ModuleNotFoundError on
# startup because the source files live in /home/agent. The bind-mount for
# /workspace happens at runtime; we don't need it on the import path.

# ---- builder ----
FROM ubuntu:26.04 AS builder

# The python packages the model's shell gets for free.
#
# The model asked for pip, and the image had none: python3-pip was in
# the builder stage only, to build the agent's own dependencies, and
# the runtime stage never got it. So every attempt to install a package
# cost a round trip through apt-get and sudo -- and burned the
# command's timeout doing it.
#
# The list lives here, once. The documents and the tool description name
# it too, and tests/test_python_env_v2180.py is what keeps them from
# drifting apart. An operator who wants a smaller image can trim it:
#   docker build --build-arg AGENT_PYTHON_PACKAGES="numpy matplotlib".
ARG AGENT_PYTHON_PACKAGES="numpy matplotlib pandas sqlalchemy openai requests httpx pillow sympy pytest tqdm"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Two requirement files: the shared runtime set, and the agent's extra
# (the MCP SDK — see requirements-agent.txt). The proxy image does not
# need the SDK, so it does not carry it.
COPY requirements.txt requirements-agent.txt /tmp/
RUN pip3 install --no-cache-dir --break-system-packages \
        --prefix=/install -r /tmp/requirements-agent.txt \
    && rm /tmp/requirements.txt /tmp/requirements-agent.txt

# The wheelhouse, and the preinstalled tree built out of it.
#
# ``pip download`` fetches the wheels once; the install then runs with
# ``--no-index`` against that local directory, so the tree is assembled
# from bytes that are already in the image and the build does not need
# pypi to be reachable twice.
#
# The tree lands in /opt/pylibs with ``--target`` instead of in the
# interpreter's site-packages, for two reasons:
#
#   * the interpreter is externally managed (PEP 668): a plain "pip
#     install" must not write into it. The refusal is correct, and the
#     tool description points the model at a virtual environment
#     instead;
#   * /opt/pylibs goes on PYTHONPATH for the model's shell only (see
#     agent_api._tmux_environment), never for the agent service. The
#     tree carries its own pydantic and httpx, and letting those
#     shadow the service's pinned dependencies would break the service
#     in a way that has nothing to do with the model.
RUN python3 -m pip download --dest /opt/wheelhouse $AGENT_PYTHON_PACKAGES \
    && python3 -m pip install --no-index --find-links=/opt/wheelhouse \
        --target=/opt/pylibs $AGENT_PYTHON_PACKAGES

# ---- runtime ----
FROM ubuntu:26.04
#
# The ``python3`` in this image is the one the Ubuntu release ships in
# apt (3.14.4 on 26.04 — measured in the image, 2026-10-25). We do not
# pin it, so a release bump moves it under us. That is what
# tests/test_runtime_python_is_covered_by_ci.py is for: whatever python
# the image ends up carrying has to be a version the CI matrix runs the
# suite on.

# The privilege mode. 0 (the default) = the agent's shell cannot become
# root: there is no sudo in the image and no setuid binary that could
# help. 1 = the image ships sudo and a NOPASSWD rule for the agent's
# user, so a command in the sandbox can run ``sudo su`` and become root
# *inside the container*.
#
# THIS IS FOR PRIVATE DEPLOYMENTS IN SECURED ENVIRONMENTS ONLY. The
# sandbox is a scratchpad for a model whose input may be hostile; with
# this on, a prompt injection that reaches the shell can become root
# inside the container. The container is then the only boundary — see
# docs/SECURITY.md, "The privilege mode".
#
# The flag also needs the runtime half of the switch: the setuid bit is
# inert while the container's no-new-privileges flag is on, and su
# cannot work at all while the capability bounding set is empty. Both
# are compose knobs (AGENT_NO_NEW_PRIVILEGES, AGENT_CAP_DROP) so that
# the default posture of a stock deployment does not change.
ARG AGENT_ALLOW_SUDO=0

# ``PIP_FIND_LINKS`` points pip at the wheelhouse that came with the
# image: installing one of the preinstalled packages is then instant
# and works without the network. The network stays available -- pip
# falls back to it for everything the wheelhouse does not carry.
#
# ``PIP_DISABLE_PIP_VERSION_CHECK`` saves a round trip to pypi on every
# pip call, which in a sandbox is a round trip the model's command
# timeout has to pay for.
#
# ``PYTHONPATH`` is the *service's* import path, and it deliberately
# does NOT carry /opt/pylibs: the preinstalled tree has its own
# pydantic and httpx, and the service's pinned dependencies must not be
# shadowed by them. The model's shell gets /opt/pylibs separately --
# see agent_api._tmux_environment.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/home/agent" \
    PIP_FIND_LINKS="/opt/wheelhouse" \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Production system packages. No build-essential, no sshpass —
# see comments in agent_api.py for what gets installed vs runtime needs.
# ``sudo`` is in the list only when the privilege mode asks for it.
#
# ``python3-pip`` and ``python3-venv`` are runtime packages now, not
# builder ones: the model installs python packages in this container,
# and a sandbox without pip cannot do that without sudo and a round
# trip through apt -- which is exactly the timeout the model was
# complaining about. python3-venv brings ensurepip, so a virtual
# environment can be made without root.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash tmux \
        openssh-client \
        git curl ca-certificates gnupg \
        jq ripgrep fd-find tree htop \
        python3 \
        python3-pip \
        python3-venv \
        $( [ "$AGENT_ALLOW_SUDO" = "1" ] && echo sudo ) \
    && rm -rf /var/lib/apt/lists/*

# The rule that lets the agent's user become root without a password.
# The username is resolved from the uid the compose contract uses
# (1000), so it does not matter whether the base image calls it
# ``ubuntu``, ``agent`` or something else.
#
# ``visudo -c`` validates the file: a broken sudoers file would make
# sudo refuse to run for *everybody*, including root, and the failure
# would look like "sudo: command not found" to the model. It earns its
# keep — it caught a bad ``Defaults!`` line while this was being
# written.
#
# ``Defaults !use_pty`` is not a style choice. Sudo runs the command in
# a pseudo-terminal of its own by default, and when that pty is torn
# down the terminal is reset — and the reset wipes the completion
# marker the agent's exec protocol depends on. The exec then times out
# even though the command succeeded and its output is right there in
# the pane. With ``!use_pty`` sudo runs the command in the same
# terminal, and the marker survives.
#
# No ``requiretty`` line: Ubuntu's sudo does not require a terminal
# (and the model's shell is a tty anyway), and the ``Defaults!user``
# form does not take a negated flag the way it looks like it should.
RUN if [ "$AGENT_ALLOW_SUDO" = "1" ]; then \
        agent_user="$(getent passwd 1000 | cut -d: -f1)"; \
        test -n "$agent_user"; \
        printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$agent_user" > /etc/sudoers.d/agent-sudo; \
        printf 'Defaults !use_pty\n' >> /etc/sudoers.d/agent-sudo; \
        chmod 0440 /etc/sudoers.d/agent-sudo; \
        visudo -c -f /etc/sudoers.d/agent-sudo; \
    fi

# Copy the pip install from the builder.
#
# Ubuntu/Debian pip is built against the *distutils* install scheme, so
# ``pip install --prefix=/install`` lays the tree down as
# ``/install/local/{bin,lib}`` — with an extra ``local`` component.
# Copying ``/install`` wholesale therefore lands the packages at
# ``/usr/local/local/...``, which the interpreter does not search, and the
# container dies with "No module named uvicorn" at startup.
#
# Verified on ubuntu:26.04 (2026-10-25): ``pip3 install --prefix=/install``
# in that image produces ``/install/local``. If a future Ubuntu release
# switches to the platform scheme, this copy breaks and the build fails
# loudly — which is the point of not "fixing" it to match the proxy's
# Dockerfile.
#
# Copy the *contents* of /install/local so the runtime layout is the
# standard /usr/local/{bin,lib}. (python:3.14-slim does NOT add the
# ``local`` component — see Dockerfile.openapi-proxy, where a plain
# ``/install/`` copy is correct. The two differ on purpose.)
COPY --from=builder /install/local/ /usr/local/

# The preinstalled python tree, and the wheelhouse it was built from.
#
# Both are read-only for the agent's user (a+rX below): the tree is a
# seed, not a place to install into. A package the model adds goes into
# a virtual environment inside the workspace instead -- the workspace
# is writable, it is executable, and it survives a container recreate,
# so the venv survives it too.
#
# The wheelhouse is copied along with the tree on purpose: it is what
# makes "pip install numpy" in a fresh venv an instant, offline
# operation instead of a download.
COPY --from=builder /opt/pylibs /opt/pylibs
COPY --from=builder /opt/wheelhouse /opt/wheelhouse
RUN chmod -R a+rX /opt/pylibs /opt/wheelhouse

# uid/gid 1000 is the contract with the host bind-mount (see
# docker-compose.yml ``user: "1000:1000"``). We reference it numerically
# instead of creating named users, because:
#
#   * ubuntu:26.04 ships uid 1000 + gid 1000 as ``ubuntu`` (verified
#     2026-10-25: ``getent passwd 1000`` -> ``ubuntu:x:1000:1000:...``),
#     so ``groupadd -g 1000 agent`` dies with "GID '1000' already
#     exists";
#   * swallowing that error (``|| true``) does not help — ``useradd``
#     then fails, and every later ``chown agent:agent`` fails too.
#
# The container stays unprivileged; only the passwd entry is gone.
RUN mkdir -p /home/agent && chown 1000:1000 /home/agent

WORKDIR /home/agent

# Agent HTTP API. The FastAPI app and the pure-function core module
# must be present in the same directory so ``from agent_core import …``
# resolves at runtime. We COPY them into /home/agent, and PYTHONPATH=/home/agent
# makes the import work regardless of the runtime CWD.
#
# ``agent_config.py`` is a third module of the same kind and is imported
# by agent_api at startup: it holds the validated stdout/binary budgets.
# Leaving it out of the image does not fail the build — it fails the
# container, with "ModuleNotFoundError: No module named 'agent_config'" on
# the first request, which is the same class of defect v2.5.0 was about.
COPY --chown=1000:1000 body_limit.py  /home/agent/body_limit.py
COPY --chown=1000:1000 agent_core.py  /home/agent/agent_core.py
COPY --chown=1000:1000 agent_config.py /home/agent/agent_config.py
COPY --chown=1000:1000 agent_api.py   /home/agent/agent_api.py
COPY --chown=1000:1000 json_logging.py /home/agent/json_logging.py
COPY --chown=1000:1000 metrics.py       /home/agent/metrics.py
#
# ``token_rules.py`` holds the rule about the bearer token that both
# services share — in particular that the template's placeholder is a
# published string, not a secret. It must be in the image: the agent
# imports it at startup, and a missing module would fail the container
# on the first request instead of the build.
COPY --chown=1000:1000 token_rules.py  /home/agent/token_rules.py
#
# ``mcp_server.py`` is the MCP face of the sandbox: the same tools, in
# the protocol an MCP caller speaks. The agent imports it at startup to
# mount the endpoint, so leaving it out does not fail the build — it
# fails the container, on the first request that reaches the endpoint.
COPY --chown=1000:1000 mcp_server.py  /home/agent/mcp_server.py

# The writable mount points. All three are tmpfs mounts at runtime, and a
# tmpfs mount point has to exist in the image: the container's root
# filesystem is read-only by default, so Docker cannot create a missing
# mount point inside it. The tmpfs itself carries mode 1777, so the
# ownership here does not decide who may write — it only keeps the image
# tidy for the case where the mount is absent.
RUN mkdir -p /workspace /var/cache/apt /home/agent/.cache/pip \
    && chown 1000:1000 /workspace /var/cache/apt /home/agent/.cache/pip
WORKDIR /workspace

USER 1000:1000
EXPOSE 8082

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8082/healthz || exit 1

# Use exec form so SIGTERM is forwarded to uvicorn (graceful shutdown).
# Set a high --timeout-graceful-shutdown — the docker-compose ``stop_grace_period``
# must be set to at least this many seconds + headroom, otherwise Docker
# SIGKILLs the container mid-shutdown.
#
# --loop asyncio is REQUIRED, not a preference. uvicorn auto-selects uvloop
# when it is importable, and under uvloop the very first ``tmux new-session``
# in a fresh container deadlocks: that call forks and daemonises the tmux
# server, and asyncio's subprocess pipes for the daemonising process never
# resolve. Every /exec call against a cold container then hangs forever while
# /healthz keeps answering 200 — the container looks healthy and does nothing.
# Verified 2026-10-20: cold container + uvloop hangs 100% of the time; the
# same container works once the tmux server is already up, and never hangs on
# plain asyncio. uvloop's throughput advantage is worth nothing here anyway —
# every command is a tmux subprocess round-trip measured in milliseconds.
CMD ["python3", "-m", "uvicorn", "agent_api:app", \
     "--host", "0.0.0.0", "--port", "8082", \
     "--loop", "asyncio", \
     "--timeout-graceful-shutdown", "25"]
