# syntax=docker/dockerfile:1.6
# Multi-stage build: builder installs pip deps, runtime image is a small
# python:3.14-slim with only the installed wheels and the app code.
#
# OpenAPI 3.0 proxy — wraps sandbox-agent in a single ``bash`` tool that
# Open WebUI can consume as an External Tool Server.

# ---- builder ----
FROM python:3.14-slim AS builder

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# ---- runtime ----
FROM python:3.14-slim

# uid/gid 1000 is free in python:3.14-slim, but the *name* ``proxy`` is
# taken: Debian ships a ``proxy`` group at GID 13 (verified 2026-10-25:
# ``getent group proxy`` -> ``proxy:x:13:``), so
# ``groupadd -g 1000 proxy`` dies with "group 'proxy' already exists".
# As with Dockerfile.sandbox we reference the ids numerically and skip
# passwd/group creation entirely. (This is a name collision, unlike the
# sandbox image which has a genuine id collision — check each base
# image separately.)
#
# No apt-get here: the image installs nothing from the distribution.
# The healthcheck used to need curl and pulled it in for that one
# purpose; it now asks Python (which is already in the image) instead,
# so the proxy image carries no package manager and no extra binaries.
RUN mkdir -p /home/proxy && chown 1000:1000 /home/proxy

# Copy the pip install from the builder.
#
# NOTE: unlike Dockerfile.sandbox, no ``local/`` unwrapping is needed here.
# python:3.14-slim builds pip against the *platform* scheme, so
# ``pip install --prefix=/install`` lays the tree down directly as
# ``/install/{bin,lib}`` (verified 2026-10-25: ``ls /install`` -> ``bin
# lib``). Verified against the base image — do not "fix" this to match
# the sandbox Dockerfile.
COPY --from=builder /install /usr/local

WORKDIR /app

# Both the FastAPI app and the pure-function core module must be present
# in the same directory so ``from proxy_core import …`` resolves.
COPY --chown=1000:1000 proxy_core.py    /app/proxy_core.py
COPY --chown=1000:1000 openapi_proxy.py /app/openapi_proxy.py
COPY --chown=1000:1000 json_logging.py   /app/json_logging.py

USER 1000:1000
EXPOSE 8090

# /healthz requires a bearer token (all proxy endpoints are authenticated
# since v2.4.3), so probing it here marks the container permanently
# unhealthy. /openapi.json is unauthenticated and is the same endpoint
# docker-compose.yml already uses for this service.
#
# The probe is Python, not curl: curl was installed into this image for
# the healthcheck alone, and a package manager plus an HTTP client are
# a bigger surface than the check is worth. A non-2xx answer raises and
# exits non-zero, which is what the healthcheck needs.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/openapi.json', timeout=2).read()"]

# Use exec form so SIGTERM is forwarded to uvicorn (graceful shutdown).
CMD ["python", "-m", "uvicorn", "openapi_proxy:app", \
     "--host", "0.0.0.0", "--port", "8090", \
     "--timeout-graceful-shutdown", "25"]
