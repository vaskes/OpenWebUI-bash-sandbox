# syntax=docker/dockerfile:1.6
# Multi-stage build: builder installs pip deps, runtime image is a small
# python:3.11-slim with only the installed wheels and the app code.
#
# OpenAPI 3.0 proxy — wraps sandbox-agent in a single ``bash`` tool that
# Open WebUI can consume as an External Tool Server.

# ---- builder ----
FROM python:3.11-slim AS builder

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# ---- runtime ----
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/proxy && chown 1000:1000 /home/proxy

# Copy the pip install from the builder.
# Debian pip places --prefix installs under /install/local/.
# Copy its *contents* so the runtime layout is the standard
# /usr/local/lib/python3.12/dist-packages (a plain
# `COPY /install /usr/local` yields /usr/local/local/... and
# the interpreter cannot find the modules).
COPY --from=builder /install/ /usr/local/

WORKDIR /app

# Both the FastAPI app and the pure-function core module must be present
# in the same directory so ``from proxy_core import …`` resolves.
COPY --chown=1000:1000 proxy_core.py    /app/proxy_core.py
COPY --chown=1000:1000 openapi_proxy.py /app/openapi_proxy.py

USER 1000:1000
EXPOSE 8090

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8090/healthz || exit 1

# Use exec form so SIGTERM is forwarded to uvicorn (graceful shutdown).
CMD ["python", "-m", "uvicorn", "openapi_proxy:app", \
     "--host", "0.0.0.0", "--port", "8090", \
     "--timeout-graceful-shutdown", "25"]
