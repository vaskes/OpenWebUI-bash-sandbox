# OpenAPI 3.0 proxy — wraps sandbox-agent in a single ``bash`` tool that
# Open WebUI can consume as an External Tool Server.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned dependencies for reproducibility.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

WORKDIR /app

# Both the FastAPI app and the pure-function core module must be present
# in the same directory so ``from proxy_core import …`` resolves.
COPY proxy_core.py    /app/proxy_core.py
COPY openapi_proxy.py /app/openapi_proxy.py

EXPOSE 8090

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8090/openapi.json || exit 1

CMD ["python", "/app/openapi_proxy.py"]
